\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Componentes temporales de roll, pitch y heave en modo \texttt  {sinusoidal} con los valores por defecto del nodo \texttt  {marine\_platform\_simulator} (\(f=0{,}1\) Hz, \(A_r=\pm 15^\circ \), \(A_p=\pm 10^\circ \), \(A_h=\pm 0{,}1\) m, \(\kappa _p=1\), \(\kappa _h=1{,}5\), desfase fijo \(\pi /3\) en pitch). La línea punteada es la consigna objetivo antes del filtro; la continua es la señal suavizada (\(\alpha =0{,}95\)) que se publica en \texttt  {/body\_pose} y en \texttt  {/marine\_platform/debug\_state}.\relax }}{26}{figure.caption.11}\protected@file@percent }
\newlabel{fig:method_motion_components}{{7}{26}{Componentes temporales de roll, pitch y heave en modo \texttt {sinusoidal} con los valores por defecto del nodo \texttt {marine\_platform\_simulator} (\(f=0{,}1\) Hz, \(A_r=\pm 15^\circ \), \(A_p=\pm 10^\circ \), \(A_h=\pm 0{,}1\) m, \(\kappa _p=1\), \(\kappa _h=1{,}5\), desfase fijo \(\pi /3\) en pitch). La línea punteada es la consigna objetivo antes del filtro; la continua es la señal suavizada (\(\alpha =0{,}95\)) que se publica en \texttt {/body\_pose} y en \texttt {/marine\_platform/debug\_state}.\relax }{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Comparación entre los patrones \texttt  {sinusoidal} e \texttt  {irregular} implementados en \texttt  {marine\_platform\_simulator} para los mismos límites de amplitud y frecuencia base. El modo sinusoidal concentra cada eje en una componente periódica simple; el modo irregular superpone varias sinusoides con distintas frecuencias relativas, generando trayectorias menos previsibles. La figura muestra la consigna \emph  {objetivo} antes del filtro de suavizado. Se adoptó el patrón sinusoidal como referencia del informe porque resulta más interpretable y reproducible para comparar estimación y ground truth.\relax }}{27}{figure.caption.12}\protected@file@percent }
\newlabel{fig:method_wave_patterns}{{8}{27}{Comparación entre los patrones \texttt {sinusoidal} e \texttt {irregular} implementados en \texttt {marine\_platform\_simulator} para los mismos límites de amplitud y frecuencia base. El modo sinusoidal concentra cada eje en una componente periódica simple; el modo irregular superpone varias sinusoides con distintas frecuencias relativas, generando trayectorias menos previsibles. La figura muestra la consigna \emph {objetivo} antes del filtro de suavizado. Se adoptó el patrón sinusoidal como referencia del informe porque resulta más interpretable y reproducible para comparar estimación y ground truth.\relax }{figure.caption.12}{}}
