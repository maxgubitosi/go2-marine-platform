\newlabel{tab:sim_drone_quant_structure}{{4.2}{54}{Resumen cuantitativo de las tres corridas del escenario con dron, calculado a partir de la evaluación \textit {offline} contra \textit {ground truth} reconstruido en el marco de la cámara. La tabla prioriza el error absoluto medio en \emph {roll}, \emph {pitch} y \emph {heave}}{table.4.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1.3}Caso base: cámara fija}{54}{subsection.4.1.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces Comparación temporal entre posición estimada y \textit  {ground truth} en el escenario base con cámara fija. La señal estimada se muestra sin sesgo medio por eje solo para visualización, con el objetivo de facilitar la comparación de forma y fase entre ambas curvas. No se aplica compensación temporal: el pequeño desfase visible entre ambas señales forma parte de la lectura diagnóstica del resultado.}}{55}{figure.caption.35}\protected@file@percent }
\newlabel{fig:sim_fixed_position_vs_gt}{{4.1}{55}{Comparación temporal entre posición estimada y \textit {ground truth} en el escenario base con cámara fija. La señal estimada se muestra sin sesgo medio por eje solo para visualización, con el objetivo de facilitar la comparación de forma y fase entre ambas curvas. No se aplica compensación temporal: el pequeño desfase visible entre ambas señales forma parte de la lectura diagnóstica del resultado}{figure.caption.35}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Distribución de errores de posición en el caso base con cámara fija. Se muestran \(\Delta X\), \(\Delta Y\), \(\Delta Z\) y el error euclidiano \(\|\Delta pos\|\), todos calculados sobre la evaluación cruda en marco cámara. Como las señales no fueron compensadas temporalmente, parte del desplazamiento respecto de cero proviene del desfase entre estimación y referencia. Una lectura centrada en cero requeriría alinear o recentrar las series antes de calcular estos histogramas.}}{56}{figure.caption.36}\protected@file@percent }
\newlabel{fig:sim_fixed_error_hist}{{4.2}{56}{Distribución de errores de posición en el caso base con cámara fija. Se muestran \(\Delta X\), \(\Delta Y\), \(\Delta Z\) y el error euclidiano \(\|\Delta pos\|\), todos calculados sobre la evaluación cruda en marco cámara. Como las señales no fueron compensadas temporalmente, parte del desplazamiento respecto de cero proviene del desfase entre estimación y referencia. Una lectura centrada en cero requeriría alinear o recentrar las series antes de calcular estos histogramas}{figure.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces Distribución cruda del error angular en el caso base con cámara fija. Aquí se muestran \(\Delta \mathit  {pitch}\) y \(\Delta \mathit  {yaw}\) sin recentrado adicional, como apoyo para la lectura angular del caso base. La componente \emph  {yaw} se incluye solo como control diagnóstico, dado que el escenario no la excita deliberadamente. El histograma conserva el desfase temporal de la cadena de medición. Por eso debe leerse como error crudo y no como una distribución ya centrada en cero.}}{56}{figure.caption.37}\protected@file@percent }
\newlabel{fig:sim_fixed_angle_error_hist_raw}{{4.3}{56}{Distribución cruda del error angular en el caso base con cámara fija. Aquí se muestran \(\Delta \mathit {pitch}\) y \(\Delta \mathit {yaw}\) sin recentrado adicional, como apoyo para la lectura angular del caso base. La componente \emph {yaw} se incluye solo como control diagnóstico, dado que el escenario no la excita deliberadamente. El histograma conserva el desfase temporal de la cadena de medición. Por eso debe leerse como error crudo y no como una distribución ya centrada en cero}{figure.caption.37}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1.4}Caso fuerte: cámara embarcada en el dron}{57}{subsection.4.1.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces Comparación entre posición estimada y \textit  {ground truth} en la corrida principal del escenario con dron \((R2)\). La señal estimada se muestra sin sesgo medio por eje solo para visualización, de modo de facilitar la lectura de fase y forma temporal.}}{58}{figure.caption.38}\protected@file@percent }
\newlabel{fig:sim_drone_position_vs_gt}{{4.4}{58}{Comparación entre posición estimada y \textit {ground truth} en la corrida principal del escenario con dron \((R2)\). La señal estimada se muestra sin sesgo medio por eje solo para visualización, de modo de facilitar la lectura de fase y forma temporal}{figure.caption.38}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.5}{\ignorespaces Comparación entre orientación estimada y \textit  {ground truth} en la corrida principal con cámara embarcada en el dron, restringida a \emph  {roll} y \emph  {pitch}. En \emph  {roll} se aplica \textit  {unwrap} angular solo para visualización, con el fin de evitar los saltos artificiales asociados a la discontinuidad en \(\pm 180^\circ \). Se omite \emph  {yaw} porque el experimento no prescribe rotación planar deliberada y esa componente no forma parte de las métricas centrales de esta etapa.}}{59}{figure.caption.39}\protected@file@percent }
\newlabel{fig:sim_drone_orientation_vs_gt}{{4.5}{59}{Comparación entre orientación estimada y \textit {ground truth} en la corrida principal con cámara embarcada en el dron, restringida a \emph {roll} y \emph {pitch}. En \emph {roll} se aplica \textit {unwrap} angular solo para visualización, con el fin de evitar los saltos artificiales asociados a la discontinuidad en \(\pm 180^\circ \). Se omite \emph {yaw} porque el experimento no prescribe rotación planar deliberada y esa componente no forma parte de las métricas centrales de esta etapa}{figure.caption.39}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.6}{\ignorespaces Distribución de errores crudos de la corrida principal del escenario con dron. La figura resume sesgo y dispersión para las componentes de posición y orientación estimadas en el marco de la cámara.}}{59}{figure.caption.40}\protected@file@percent }
\newlabel{fig:sim_drone_error_hist}{{4.6}{59}{Distribución de errores crudos de la corrida principal del escenario con dron. La figura resume sesgo y dispersión para las componentes de posición y orientación estimadas en el marco de la cámara}{figure.caption.40}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.7}{\ignorespaces Comparación entre las tres corridas del escenario con dron. Se muestran diagramas de caja de error absoluto en las variables que más interesan para la lectura marina del problema: \(|\Delta \mathit  {roll}|\), \(|\Delta \mathit  {pitch}|\) y \(|\Delta \mathit  {heave}| = |\Delta Z|\).}}{60}{figure.caption.41}\protected@file@percent }
\newlabel{fig:sim_drone_runs_comparison}{{4.7}{60}{Comparación entre las tres corridas del escenario con dron. Se muestran diagramas de caja de error absoluto en las variables que más interesan para la lectura marina del problema: \(|\Delta \mathit {roll}|\), \(|\Delta \mathit {pitch}|\) y \(|\Delta \mathit {heave}| = |\Delta Z|\)}{figure.caption.41}{}}
