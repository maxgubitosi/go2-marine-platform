\@writefile{lof}{\contentsline {figure}{\numberline {3.8}{\ignorespaces Cadena de control de una pata basada en el Jacobiano, que el \emph  {stack} de simulación adopta: el generador de consignas fija la posición de pie deseada \([p_x, p_y]\), la cinemática directa y el Jacobiano de pata la vinculan con el espacio articular, y un lazo de impedancia/PD genera los torques. El Jacobiano de contacto \(J_c(q)\) introduce la fuerza externa de apoyo \(F_{\text  {ext}}\). Adaptado de \citet {Lee2013Cheetah}.}}{32}{figure.caption.24}\protected@file@percent }
\newlabel{fig:leg_control_chain}{{3.8}{32}{Cadena de control de una pata basada en el Jacobiano, que el \emph {stack} de simulación adopta: el generador de consignas fija la posición de pie deseada \([p_x, p_y]\), la cinemática directa y el Jacobiano de pata la vinculan con el espacio articular, y un lazo de impedancia/PD genera los torques. El Jacobiano de contacto \(J_c(q)\) introduce la fuerza externa de apoyo \(F_{\text {ext}}\). Adaptado de \citet {Lee2013Cheetah}}{figure.caption.24}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.9}{\ignorespaces Marcos de referencia empleados en el entorno. Se muestran el marco global \texttt  {world} \(\{w\}\), la referencia plana del robot \texttt  {base\_footprint} \(\{bf\}\), el torso \texttt  {base\_link} \(\{bl\}\), el marco del marcador ArUco \(\{a\}\) y la cadena de la cámara hasta \texttt  {camera\_link\_optical} \(\{c\}\). La salida publicada en \texttt  {/aruco/pose} queda expresada en ese marco óptico, de modo que esta cadena geométrica es la base de la comparación entre pose estimada y \textit  {ground truth}.}}{33}{figure.caption.25}\protected@file@percent }
