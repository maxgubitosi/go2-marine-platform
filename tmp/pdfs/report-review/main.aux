\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces Interpretación física simplificada del movimiento de una plataforma sobre las olas. De izquierda a derecha: elevación local de la superficie libre, que induce \emph  {heave}; diferencia de altura entre proa y popa, que induce \emph  {pitch}; y diferencia de altura entre babor y estribor, que induce \emph  {roll}.}}{19}{figure.caption.12}\protected@file@percent }
\newlabel{fig:wave_platform_response}{{3.1}{19}{Interpretación física simplificada del movimiento de una plataforma sobre las olas. De izquierda a derecha: elevación local de la superficie libre, que induce \emph {heave}; diferencia de altura entre proa y popa, que induce \emph {pitch}; y diferencia de altura entre babor y estribor, que induce \emph {roll}}{figure.caption.12}{}}
\newlabel{eq:marine_kinematics}{{3.1}{19}{Modelo reducido de movimiento de plataforma marina}{equation.3.1}{}}
\newlabel{eq:marine_dynamics}{{3.2}{19}{Modelo reducido de movimiento de plataforma marina}{equation.3.2}{}}
\newlabel{eq:reduced_marine_state}{{3.3}{20}{Modelo reducido de movimiento de plataforma marina}{equation.3.3}{}}
\newlabel{eq:platform_finite_difference_response}{{3.4}{21}{Modelo reducido de movimiento de plataforma marina}{equation.3.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces Esquema del efecto del oleaje sobre una embarcación: se identifican las cuatro zonas representativas de la cubierta (proa, popa, babor y estribor) y se sugiere cómo las diferencias de altura del agua bajo esos puntos se traducen en \emph  {heave} (traslación vertical neta), \emph  {pitch} (inclinación proa--popa) y \emph  {roll} (inclinación babor--estribor). Esta lectura motiva la aproximación discreta usada en el texto.}}{21}{figure.caption.13}\protected@file@percent }
\newlabel{fig:platform_corner_heights}{{3.2}{21}{Esquema del efecto del oleaje sobre una embarcación: se identifican las cuatro zonas representativas de la cubierta (proa, popa, babor y estribor) y se sugiere cómo las diferencias de altura del agua bajo esos puntos se traducen en \emph {heave} (traslación vertical neta), \emph {pitch} (inclinación proa--popa) y \emph {roll} (inclinación babor--estribor). Esta lectura motiva la aproximación discreta usada en el texto}{figure.caption.13}{}}
\newlabel{eq:sinusoidal_wave_model}{{3.5}{22}{Modelo reducido de movimiento de plataforma marina}{equation.3.5}{}}
\newlabel{eq:harmonic_wave_model}{{3.6}{22}{Modelo reducido de movimiento de plataforma marina}{equation.3.6}{}}
